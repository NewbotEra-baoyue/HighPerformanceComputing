# 文件: Config/my_cpu

ERT_RESULTS Results.MyCPU
ERT_DRIVER driver1
ERT_KERNEL kernel1

ERT_MPI False
ERT_OPENMP True
ERT_OPENMP_CFLAGS -fopenmp
ERT_OPENMP_LDFLAGS -fopenmp

ERT_FLOPS 1,2,4,8,16
ERT_ALIGN 64

ERT_CC g++
ERT_CFLAGS -O3 -march=native -fstrict-aliasing -ftree-vectorize -funroll-loops
ERT_LD g++
ERT_LDFLAGS
ERT_LDLIBS

ERT_RUN export OMP_NUM_THREADS=ERT_OPENMP_THREADS; ERT_CODE
ERT_PROCS_THREADS 1,2,4,8,16,32,64
ERT_MPI_PROCS 1

ERT_NUM_EXPERIMENTS 3
ERT_MEMORY_MAX 1073741824
ERT_WORKING_SET_MIN 1
ERT_TRIALS_MIN 1

ERT_GNUPLOT gnuplot

ERT_OPENMP_THREADS 1,2,4,8,16,32